# URBANPULSE AI — MASTER ENVIRONMENT CONFIGURATION
# Copy to .env for local development or set in Cloud Provider Console (Render / Vercel / Supabase)

# Application Environment
APP_ENV=production
SECRET_KEY=urbanpulse-sih2026-super-secret-jwt-key-do-not-share
JWT_SECRET=urbanpulse-sih2026-super-secret-jwt-key-do-not-share
PORT=8000

# Database Configuration (SQLite default for dev; PostgreSQL / Supabase for production)
DATABASE_URL=sqlite:///urbanpulse.db
# DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,https://urbanpulse.vercel.app,http://localhost:3000

# Transactional Email Notification Service (SendGrid)
SENDGRID_API_KEY=SG.demo_key_replace_in_prod
SENDGRID_FROM_EMAIL=alerts@urbanpulse.ai

# Transactional SMS Notification Service (Twilio)
TWILIO_ACCOUNT_SID=AC_demo_sid_replace_in_prod
TWILIO_AUTH_TOKEN=demo_auth_token_replace_in_prod
TWILIO_FROM_NUMBER=+18005550199

# Storage Engine Abstraction
STORAGE_BUCKET=urbanpulse-evidence-clips

# Edge AI Perception Model Provider
MODEL_PROVIDER=simulation_onnx_hybrid
MODEL_PATH=./ai/models/yolov9_int8.onnx

# Frontend API & WebSocket URLs
VITE_API_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000/ws
